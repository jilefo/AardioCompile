    emit("      CI 排错请务必带 --log。");
};

var showVersion = function(){
    emit("aac " ++ AAC_VERSION);
    emit("包格式 : v" ++ aacpkg.FORMAT_VER);
    emit("内核指纹: " ++ aacpkg.kernelStamp());
};

// ============================================================
//  参数合法性校验
// ============================================================

// 未知选项必须拦掉。旧实现静默忽略, 结果 --outt=xxx 之类的拼写错误
// 会让产物落到默认位置, 用户完全察觉不到。
// 循环变量局部化, 避免与调用方互相覆盖
var checkArgs = function(){
    if(!#unknownOpts){ return true; }
    var m = 0;
    for(m = 1; #unknownOpts; 1){
        err("未知参数: " ++ unknownOpts[m]);
    }
    emit("");
    emit("若这些参数是给脚本用的，请用 -- 分隔：aac exec pkg --no-pause -- <脚本参数>");
    emit("");
    showHelp();
    pauseIfNeed();
    hardExit(1);
    return false;
};

// ============================================================
//  .aproj 解析（XML 宽容解析）
// ============================================================

// aardio 的 string.find / string.match 走「模式匹配」语法, 其中 <...>
// 是特殊结构(平衡匹配), 模式串里出现未闭合的 '<' 会抛 malformed pattern。
// XML 里到处是 '<' '>', 因此解析一律用 string.indexOf（纯子串查找）。
var makeXmlReader = function(xml){
    var r = {};
    r.xml = xml;

    // .aproj 首行是 XML 声明 <?xml version="1.0" encoding="utf-8"?>。
    // 旧实现取「全文第一个 '>'」作为标签结束位置, 结果 head 被截到声明处,
    // output / FileVersion / publishDir 全部读到 null（版本号回退成 1.0.0,
    // 产物也不落在 publishDir 里）。必须先把正文移到真正的 <project ...> 标签。
    var ps = string.indexOf(r.xml, "<project");
    if(ps){
        r.xml = string.right(r.xml, #r.xml - (ps + 7));
    }

    // 取 <project ...> 的属性区（到该标签的 '>' 为止）
    r.head = null;
    var gt0 = string.indexOf(r.xml, ">");
    if(gt0){ r.head = string.left(r.xml, gt0 - 1); }

    r.field = function(tag){
        if(!r.xml){ return null; }
        var s = string.indexOf(r.xml, "<" ++ tag);
        if(!s) return null;
        var gt = string.indexOf(r.xml, ">", s);
        if(!gt) return null;
        var body = string.right(r.xml, #r.xml - gt);
        var close = string.indexOf(body, "</");
        if(!close) return null;
        return string.left(body, close - 1);
    };

    r.attr = function(name){
        if(!r.head){ return null; }
        // 含双引号的字面量必须用反引号原义串（双引号串里 \" 不是转义）
        var p = string.indexOf(r.head, name ++ `="`);
        if(!p) return null;
        var rest = string.right(r.head, #r.head - (p + #name + 1));
        var q = string.indexOf(rest, `"`);
        if(!q) return null;
        return string.left(rest, q - 1);
    };

    return r;
};

// 判断 import 的名字是不是「工程自己的模块」而非第三方/标准库。
// 工程里有 lib/utils.aardio 时, 源码里的 import utils 是内部模块, 不该判缺失。
// 循环变量全部局部声明: 这些函数在 cmdBuild 的循环体里被调用,
// 一旦共用全局 i/j/k 就会把外层的迭代指针冲掉
var isProjectModule = function(nm, files){
    var parts = string.split(nm, ".");
    var p = "";
    var q = 0;
    for(q = 1; #parts; 1){
        if(q > 1){ p = p ++ "/"; }
        p = p ++ parts[q];
    }
    // 【坑】工程根目录下的 lib/ 也会被 aardio 加进 import 搜索路径:
    // lib/config.aardio 就是 `import config` 的目标。
    // 只比对根目录这一条时, 真实工程里大量自带模块会被误报成
    // "宿主未预埋库" —— 实测 126 个开源工程里 config/style/etip 之类
    // 满屏都是, 全是假阳性。必须把 lib/ 前缀也算进去。
    var cands = {
        p ++ ".aardio";
        "lib/" ++ p ++ ".aardio";
        p ++ "/_.aardio";
        "lib/" ++ p ++ "/_.aardio";
        p ++ "/main.aardio";
        "lib/" ++ p ++ "/main.aardio";
    };
    var k = 0;
    for(q = 1; #files; 1){
        var rel = files[q].rel;
        for(k = 1; #cands; 1){
            if(rel == cands[k]){ return true; }
        }
    }
    return false;
};

// ---- 定位运行时宿主 ----
// 结果缓存: 依赖检查和生成 EXE 都要用它, 避免重复读盘。
var hostResolved = false;
var hostResolvedPath = null;

var locateHost = function(){
    if(hostResolved){ return hostResolvedPath; }
    hostResolved = true;
    hostResolvedPath = null;

    var hp = optVal("--host");
    if(hp){
        hp = normPath(io.fullpath(hp));
        if(!fileExists(hp)){
            warn("--host 指定的文件不存在: " ++ hp);
            hp = null;
        }
    }
    if(!hp){
        var toolDir = normPath(io.splitpath(io._exepath).dir);
            var cands = {
                toolDir ++ "/aardioHost.exe";
                normPath(toolDir ++ "/..") ++ "/aardioHost.exe";
            };
            for(q = 1; #cands; 1){
                if(fileExists(cands[q])){
                    hp = cands[q];
                    break;
                }
            }
    }
    hostResolvedPath = hp;
    return hp;
};

// ============================================================
//  子命令: build
// ============================================================

var cmdBuild = function(){
    // --- 1. 工程路径 ---
    var projArg = positional[1];
    if(!projArg){
        err("请指定工程路径");
        emit("用法: aac build <工程目录|.aproj> [--out=路径] [--name=应用名] [--no-pause]");
        pauseIfNeed();
        return 1;
    }

    var projRaw = projArg;
    projArg = normPath(io.fullpath(projArg));
    if(!fileExists(projArg)){
        notFoundInput("工程路径", projRaw, projArg);
        pauseIfNeed();
        return 1;
    }

    // --- 2. 工程目录与 .aproj ---
    var projDir  = null;
    var projFile = null;

    if(string.endWith(projArg, ".aproj", true)){
        projFile = projArg;
        projDir  = parentDir(projArg) || ".";
    }
    else {
        projDir = projArg;
        fsys.enum(projDir, "*.aproj", function(dir, filename, fullpath){
            if(filename && !projFile){
                projFile = normPath(fullpath);
            }
        }, false);
    }
    projDir = normPath(projDir);

    info("工程目录: " ++ projDir);
    if(projFile){
        info("工程文件: " ++ projFile);
    }
    else {
        warn("未找到 .aproj 文件，应用名/版本将取默认值");
    }

    var xml = null;
    if(projFile && fileExists(projFile)){
        xml = string.load(projFile);
    }
    var xr = makeXmlReader(xml);

    // --- 3. 应用名 / 版本 / 输出目录 ---
    var appName = optVal("--name");
    if(!appName){
        appName = xr.attr("output");
    }
    if(!appName || !#appName){
        var nameTags = {"OutFileName"; "OutputFileName"; "OutputFile"; "FileName"; "Name"};
        for(i = 1; #nameTags; 1){
            var t = xr.field(nameTags[i]);
            if(t && #t){ appName = t; break; }
        }
    }
    if(!appName || !#appName){
        appName = xr.attr("name");
    }

    var ver = optVal("--ver");
    if(!ver){ ver = xr.attr("FileVersion"); }
    if(!ver){ ver = xr.field("Version"); }
    if(!ver || !#ver){ ver = "1.0.0"; }

    // publishDir: .aproj 里形如 "/dist/"
    var pubDir = xr.attr("publishDir");
    var outDir = projDir;
    if(pubDir && #pubDir){
        var pd = normPath(pubDir);
        // 可能是 "/dist/" 这种以斜杠开头的相对写法
        pd = string.replace(pd, CH_BACKSLASH, "/");
        while(string.left(pd, 1) == "/"){
            pd = string.right(pd, #pd - 1);
        }
        if(#pd){
            outDir = normPath(projDir ++ "/" ++ pd);
        }
    }

    // --- 4. 解析 --out ---
    // 语义（重要，旧版本在这里会把 .appkg 直接写成 .exe）:
    //   以 / 或 \ 结尾, 或不含扩展名  -> 目录
    //   以 .exe 结尾                  -> 独立 EXE 的完整路径
    //   以 .appkg 结尾                -> 包文件的完整路径
    var cliOut = optVal("--out");
    var outPkg = null;
    var outExe = null;

    if(cliOut){
        var co = normPath(cliOut);
        var isExeOut = string.endWith(co, ".exe", true);
        var isPkgOut = string.endWith(co, ".appkg", true);

        if(isExeOut || isPkgOut){
            var abs = normPath(io.fullpath(co));
            var dir = parentDir(abs);
            var nm  = stripExt(baseName(abs));
            if(#nm){ appName = nm; }
            if(isExeOut){
                outExe = abs;
                outDir = dir;
            }
            else {
                outPkg = abs;
                outDir = dir;
            }
        }
        else {
            // 目录（相对路径基于当前工作目录）
            outDir = normPath(io.fullpath(co));
        }
    }

    appName = stripExt(S(appName));
    if(!#appName){
        appName = stripExt(baseName(projDir));
    }
    if(!#appName){ appName = "app"; }

    if(!outPkg){ outPkg = normPath(outDir ++ "/" ++ appName ++ ".appkg"); }
    if(!outExe){ outExe = normPath(outDir ++ "/" ++ appName ++ ".exe"); }

    // --- 写保护: 绝不让产物覆盖工具链自身 ---
    // --out 指到 aac.exe / aardioHost.exe 会直接毁掉整套工具,
    // 而这类误操作在 CI 里极难回溯（表现只是一个莫名其妙的后续失败）。
    var selfExe = normPath(io._exepath);
    if(normPath(outPkg) == selfExe || normPath(outExe) == selfExe){
        return exitErr("输出路径指向 aac 自身，已拒绝写入: " ++ selfExe);
    }
    var hp0 = locateHost();
    if(hp0 && (normPath(hp0) == normPath(outPkg) || normPath(hp0) == normPath(outExe))){
        return exitErr("输出路径指向运行时宿主，已拒绝写入（会毁掉工具链）: " ++ hp0);
    }

    info("应用名称: " ++ appName);
    info("版本号  : " ++ ver);
    info("输出目录: " ++ outDir);

    // --- 5. main.aardio ---
    var mainFull = normPath(projDir ++ "/main.aardio");
    if(!fileExists(mainFull)){
        return exitErr("工程缺少入口文件 main.aardio: " ++ mainFull);
    }

    // --- 6. 收集源文件 ---
    var excl = {".build"; "dist"; "bin"; "obj"; ".git"; ".svn"; "node_modules"; ".vscode"};
    var ex = optVal("--exclude");
    if(ex){
        var parts = string.split(ex, ",");
        for(i = 1; #parts; 1){
            if(#parts[i]){ table.push(excl, parts[i]); }
        }
    }

    var srcFiles = {};
    fsys.enum(projDir, "*.aardio", function(dir, filename, fullpath){
        if(!filename){ return; }
        var rel = normPath(fullpath);
        var prefix = projDir ++ "/";
        if(#rel > #prefix && string.left(rel, #prefix) == prefix){
            rel = string.right(rel, #rel - #prefix);
        }
        if(aacpkg.isExcluded(rel, excl)){ return; }
        table.push(srcFiles, {rel = rel; full = normPath(fullpath)});
    }, true);

    if(#srcFiles == 0){
        return exitErr("工程目录下未找到任何 .aardio 源文件: " ++ projDir);
    }
    sortByRel(srcFiles);
    info("发现源文件: " ++ #srcFiles ++ " 个");

    // --- 6.5 依赖检查: 工程用到的库是否都在宿主里预埋 ---
    // 独立 EXE 的库只能来自「宿主发布时被 IDE 嵌入的那一份」。
    // 缺库的话编译期一切正常, 双击运行才报"找不到库", 是典型的难查故障,
    // 所以在 build 阶段就算清楚。
    if(!hasOpt("--no-lib-check")){
        var hostLibs = null;
        if(hp0){
            hostLibs = extractHostLibs(string.load(hp0));
            if(!hostLibs){
                warn("无法从宿主读出预埋库清单，已跳过依赖检查（建议重建 aardioHost.exe）");
            }
        }
        if(hostLibs){
            var need = {};
            for(i = 1; #srcFiles; 1){
                var scode = string.load(srcFiles[i].full);
                if(!scode){ continue; }
                var imps = scanImports(scode);
                for(j = 1; #imps; 1){
                    table.push(need, {lib = imps[j]; from = srcFiles[i].rel});
                }
            }
            var miss = {};
            for(i = 1; #need; 1){
                var nm0 = need[i].lib;
                if(isProjectModule(nm0, srcFiles)){ continue; }
                if(isOneOf(hostLibs, nm0)){ continue; }
                // 内核内置命名空间: 任何 aardio EXE 里都有, 报缺就是误报
                if(isOneOf(KERNEL_NS, nm0)){ continue; }
                // 相对导入 (import ..xxx / import .xxx): 名字是相对当前命名空间
                // 解析的, 静态扫描拿不到基准命名空间, 硬判必然误报。
                // 不拦构建, 但要显式提醒 —— 静默放过才是生产级工具的大忌。
                if(string.startWith(nm0, ".")){
                    warn("相对导入无法静态校验，请自行确认运行期可用: "
                         ++ nm0 ++ "  （被 " ++ need[i].from ++ " 引用）");
                    continue;
                }
                table.push(miss, need[i]);
            }
            if(#miss){
                // ---- --auto-host: 别让用户自己去补库, 直接闭环 ----
                // 预埋必须经 IDE 发布, 运行时补不了；这一步代为执行
                // 「改宿主源码 + 重建宿主」，然后重新检查。真实开源工程里
                // 十有八九会撞上缺库，把它做成一条命令是可用性的分水岭。
                if(hasOpt("--auto-host")){
                    var names = {};
                    for(i = 1; #miss; 1){
                        if(!isOneOf(names, miss[i].lib)){ table.push(names, miss[i].lib); }
                    }
                    var alog = normPath(outDir ++ "/_autohost.log");
                    var aacExe = normPath(io._exepath);
                    info("自动补库: " ++ joinText(names, ", "));
                    info("正在重建宿主（需 IDE 发布一次，约 10~20 秒）...");
                    var perr = null;
                    try{
                        var pr = io.popen("cmd /c " ++ CH_QUOTE ++ aacExe ++ CH_QUOTE
                                      ++ " host-add " ++ CH_QUOTE ++ joinText(names, ",") ++ CH_QUOTE
                                      ++ " --rebuild --no-pause --log=" ++ CH_QUOTE ++ alog ++ CH_QUOTE, "r");
                        // readAll 会一直等到子进程结束 —— 这正是我们要的同步点。
                        // 读不到输出也没关系, 子进程的诊断都写进 --log 了。
                        if(pr){
                            try{ pr.readAll(); } catch(e2){ /* 读不到输出无所谓, 诊断在子进程 --log 里 */ }
                            try{ pr.close(); }  catch(e3){ /* 同上 */ }
                        }
                    }
                    catch(e){ perr = S(e); }
                    if(perr){
                        err("自动补库启动失败: " ++ perr);
                    }
                    else {
                        // 重新读宿主清单（EXE 已被替换）
                        var hostLibs2 = extractHostLibs(string.load(hp0));
                        if(hostLibs2){
                            hostLibs = hostLibs2;
                            var miss2 = {};
                            for(i = 1; #miss; 1){
                                if(!isOneOf(hostLibs2, miss[i].lib)){
                                    table.push(miss2, miss[i]);
                                }
                            }
                            if(#miss2 == 0){
                                ok("自动补库完成，宿主已重建，依赖检查通过");
                                miss = {};
                            }
                            else {
                                warn("自动补库后仍缺 " ++ #miss2 ++ " 个库（多半是重依赖库被拦下，或第三方库）");
                                miss = miss2;
                            }
                        }
                        else {
                            warn("重建后读不出宿主预埋清单，无法确认是否补齐");
                        }
                    }
                }

                if(#miss){
                    for(i = 1; #miss; 1){
                        err("宿主未预埋库: " ++ miss[i].lib ++ "  （被 " ++ miss[i].from ++ " 引用）");
                    }
                    reportMissingLibs(miss);
                    return exitErr("依赖检查未通过（宿主预埋库缺失）");
                }
            }
            info("依赖检查  : 通过（宿主已预埋全部所需库）");
        }
    }

    // --- 7. 注入构建信息（内存中完成, 绝不改动磁盘上的源码）---
    // 旧实现会把构建信息写回 main.aardio 再做备份/回滚:
    // 一旦编译失败或进程被中断, 用户源码就带着注入块留在磁盘上,
    // 下一次构建还会拼出嵌套注释, 语法直接崩。现在只在内存里拼。
    var mainSrc = string.load(mainFull);
    if(!mainSrc){
        return exitErr("无法读取 main.aardio: " ++ mainFull);
    }
    mainSrc = stripBuildInfo(mainSrc);

    var headMark = "/*__BUILD_INFO_BEGIN__*/";
    var endMark  = "/*__BUILD_INFO_END__*/";
    var infoBlock = headMark
        ++ `var APP_NAME = "` ++ escStr(appName) ++ `";`
        ++ `var APP_VERSION = "` ++ escStr(ver) ++ `";`
        ++ `var BUILD_TIME = "` ++ escStr(time()) ++ `";`
        ++ endMark;
    var mainFinal = infoBlock ++ mainSrc;

    // --- 8. 编译 ---
    info("---- 开始编译 ----");

    // 编译期的当前目录必须是工程目录 —— IDE 发布时就是这么做的。
    // 否则源码里 `web/import.js` 这类相对包含会按 aac 自己所在目录去解析。
    // 用户显式给了 --cwd 就以用户为准, 不抢。
    if(!cwdBase){
        fsys.setCurDir(projDir);
    }

    var items = {};
    var errs = {};
    var incFixed = 0;

    for(i = 1; #srcFiles; 1){
        var it = srcFiles[i];
        var src = string.load(it.full);
        if(!src){
            table.push(errs, it.rel ++ "：无法读取（文件为空？）");
        }
        else {
            if(it.rel == "main.aardio"){
                src = mainFinal;
            }
            // $"/res/x" 这类工程根相对包含: IDE 能解析, 独立 EXE 不行,
            // 这里在内存里补成工程目录下的绝对路径（磁盘源码不动）。
            var fx = fixIncludeRoots(src, projDir);
            src = fx;
            var bc, cerr = compileSource(src);
            if(!bc){
                table.push(errs, it.rel ++ "：" ++ S(cerr));
            }
            else {
                table.push(items, {rel = it.rel; code = bc});
                ok(it.rel ++ " (" ++ #bc ++ " 字节)");
            }
        }
    }

    // 汇总全部错误再退出, 一次暴露所有语法问题而不是遇到第一个就停
    if(#errs){
        for(i = 1; #errs; 1){
            err("编译失败: " ++ errs[i]);
        }
        return exitErr("共 " ++ #errs ++ " 个文件编译失败（磁盘源码未被修改）");
    }

    // --- 9. 打包 ---
    var meta = {};
    meta["fmt"]    = aacpkg.FORMAT_VER;
    meta["kernel"] = aacpkg.kernelStamp();
    meta["app"]    = appName;
    meta["ver"]    = ver;
    meta["time"]   = S(time());
    var pkgData = aacpkg.pack(items, meta);

    // 产物自检: 写盘前先按宿主的解析路径跑一遍, 确保一定读得出来
    var chk, chkErr = aacpkg.parse(pkgData);
    if(!chk){
        return exitErr("产物自检失败（包无法解析）: " ++ S(chkErr));
    }
    if(#chk.files != #items){
        return exitErr("产物自检失败（文件数不符: " ++ #chk.files ++ " / " ++ #items ++ "）");
    }

    ensureDir(parentDir(outPkg));
    if(!string.save(outPkg, pkgData)){
        return exitErr("包文件写入失败: " ++ outPkg ++ "（目标被占用或无写权限？）");
    }
    ok("包文件: " ++ outPkg ++ " (" ++ #pkgData ++ " 字节)");

    // --- 10. 独立 EXE ---
    var exeMade = null;
    if(!hasOpt("--no-exe")){
        var hostPath = locateHost();

        if(hostPath){
            info("运行时宿主: " ++ hostPath);
            var hostBin = string.load(hostPath);
            if(!hostBin){
                warn("读取宿主失败: " ++ hostPath);
            }
            else {
                ensureDir(parentDir(outExe));
                var exeBin = hostBin ++ pkgData;
                if(!string.save(outExe, exeBin)){
                    err("EXE 写入失败: " ++ outExe);
                    emit("常见原因: 该 EXE 正在运行被占用，或目标目录无写权限。");
                    return exitErr("EXE 写入失败（若目标正在运行请先关闭）");
                }
                exeMade = outExe;
                ok("独立EXE: " ++ outExe ++ " (" ++ #exeBin ++ " 字节)");
            }
        }
        else {
            warn("未找到 aardioHost.exe，只生成了 .appkg");
            warn("把 aardioHost.exe 放到 aac 同目录即可自动产出独立 EXE");
        }
    }

    // --- 11. 报告 ---
    emit("");
    emit("==========================================");
    emit("  构建完成");
    emit("  应用名称 : " ++ appName);
    emit("  应用版本 : " ++ ver);
    emit("  源文件数 : " ++ #srcFiles);
    emit("  包文件   : " ++ outPkg ++ " (" ++ #pkgData ++ " 字节)");
    if(exeMade){
        emit("  独立EXE  : " ++ exeMade);
    }
    emit("==========================================");
    emit("");

    // 给 CI / AI 的可解析结果行
    ok("BUILD SUCCESS");
    ok("PKG=" ++ outPkg);
    if(exeMade){
        ok("EXE=" ++ exeMade);
    }

    emit("");
    if(exeMade){
        emit("运行方式:");
        emit("  " ++ exeMade);
    }
    else {
        emit("运行方式:");
        emit("  aac exec " ++ outPkg ++ " --no-pause");
    }
    emit("");
    emit("注意: 字节码与 aardio 内核版本绑定，升级 aardio 后需重新 build。");

    pauseIfNeed();
    return 0;
};

// ============================================================
//  子命令: compile
// ============================================================

var cmdCompile = function(){
    var srcPath = positional[1];
    var outPath = positional[2];

    if(!srcPath || !outPath){
        err("用法: aac compile <源文件.aardio> <输出.dump> [--no-pause]");
        pauseIfNeed();
        return 1;
    }

    var srcRaw = srcPath;
    srcPath = normPath(io.fullpath(srcPath));
    outPath = normPath(io.fullpath(outPath));

    if(!fileExists(srcPath)){
        notFoundInput("源文件", srcRaw, srcPath);
        pauseIfNeed();
        return 1;
    }

    var source = string.load(srcPath);
    if(!source){
        return exitErr("源文件为空或读取失败: " ++ srcPath);
    }

    info("正在编译: " ++ srcPath);
    var bytecode, compErr = compileSource(source);
    if(!bytecode){
        return exitErr("编译失败，请检查源码语法（" ++ S(compErr) ++ "）");
    }

    // 自检: 刚产出的字节码必须能被自己 loadcode 回来
    var check, cerr = loadcode(bytecode);
    if(!check){
        return exitErr("编译产物自检失败: " ++ S(cerr));
    }

    ensureDir(parentDir(outPath));
    if(!string.save(outPath, bytecode)){
        return exitErr("字节码写入失败: " ++ outPath);
    }

    ok("编译成功: " ++ srcPath ++ " -> " ++ outPath);
    info("字节码大小: " ++ #bytecode ++ " 字节");
    info("运行: aac run " ++ outPath ++ " --no-pause");

    pauseIfNeed();
    return 0;
};

// ============================================================
//  子命令: run
// ============================================================

var cmdRun = function(){
    var scriptPath = positional[1];
    if(!scriptPath){
        err("用法: aac run <脚本.aardio|.dump> [脚本参数...] [--no-pause]");
        pauseIfNeed();
        return 1;
    }

    var scriptRaw = scriptPath;
    scriptPath = normPath(io.fullpath(scriptPath));
    if(!fileExists(scriptPath)){
        notFoundInput("脚本文件", scriptRaw, scriptPath);
        pauseIfNeed();
        return 1;
    }

    var code = string.load(scriptPath);
    if(!code){
        return exitErr("文件为空或读取失败: " ++ scriptPath);
    }

    // loadcode 既能加载源码，也能加载 dumpcode 产出的字节码
    var func, lerr = loadcode(code);
    if(!func){
        err("编译失败: " ++ scriptPath);
        err(S(lerr));
        if(string.find(S(lerr), "bad code")){
            err("原因: 字节码由旧版本 aardio 编译，与当前内核不匹配，请重新编译。");
        }
        pauseIfNeed();
        return 1;
    }

    var runArgs = scriptArgs();
    // _ARGV 是内核常量不可改, 用全局 APP_ARGS 把干净参数交给脚本
    APP_ARGS = runArgs;

    info("正在运行: " ++ scriptPath);
    var ret = null;
    var runErr = null;
    try{
        ret = func(table.unpack(runArgs));
        if(ret != null){
            info("脚本返回: " ++ S(ret));
        }
    }
    catch(e){
        runErr = S(e);
    }
    // 【坑】不能把 return exitErr(...) 写在 catch 里 —— aardio 的 try/catch
    // 内部 return 不生效，错误会被吞掉，崩溃的脚本照样返回退出码 0，
    // CI 里就成了「失败被判成功」。
    if(runErr){
        return exitErr("运行时错误: " ++ runErr);
    }

    // 脚本的 return 值就是进程退出码, 这样 aac run 才能用于 CI 判定
    pauseIfNeed();
    return toExitCode(ret);
};

// ============================================================
//  子命令: exec —— 执行 .appkg
// ============================================================

var preparePkg = function(pkgPath){
    var pkgRaw = pkgPath;
    pkgPath = normPath(io.fullpath(pkgPath));
    if(!fileExists(pkgPath)){
        notFoundInput("包文件", pkgRaw, pkgPath);
        return null, null, "包文件不存在";
    }
    var bin = string.load(pkgPath);
    if(!bin){
        return null, null, "包文件读取失败: " ++ pkgPath;
    }
    var pkg, perr = aacpkg.parse(bin);
    if(!pkg){
        return null, null, "包解析失败: " ++ S(perr);
    }
    return pkg, pkgPath, null;
};

// 建立 PKG 表与 loadModule，供载荷内的 main.aardio 加载工程内模块
var installPkg = function(pkg){
    PKG = {};
    for(i = 1; #pkg.files; 1){
        PKG[pkg.files[i].rel] = pkg.files[i].code;
    }
    loadModule = function(relPath){
        relPath = string.replace(S(relPath), CH_BACKSLASH, "/");
        var code = PKG[relPath];
        if(!code){
            return null, "模块不存在: " ++ relPath;
        }
        var f, e = loadcode(code);
        if(!f){
            return null, S(e);
        }
        return f;
    };
};

var cmdExec = function(){
    var pkgPath = positional[1];
    if(!pkgPath){
        err("用法: aac exec <包文件.appkg> [脚本参数...] [--no-pause]");
        pauseIfNeed();
        return 1;
    }

    var pkg, real, perr = preparePkg(pkgPath);
    if(!pkg){
        return exitErr(perr);
    }

    // 内核指纹不一致时提前告警, 而不是等 loadcode 抛 "bad code"
    var kstamp = pkg.meta["kernel"];
    if(kstamp && kstamp != aacpkg.kernelStamp()){
        warn("包由不同版本 aardio 内核编译（包内 " ++ S(kstamp) ++ " / 本机 " ++ aacpkg.kernelStamp() ++ "），可能无法运行");
    }

    info("包已加载: " ++ S(real));
    info("包含文件: " ++ #pkg.files ++ " 个");

    installPkg(pkg);

    var mainCode = PKG["main.aardio"];
    if(!mainCode){
        return exitErr("包内缺少 main.aardio 入口文件");
    }

    var func, lerr = loadcode(mainCode);
    if(!func){
        err("main.aardio 字节码加载失败: " ++ S(lerr));
        if(string.find(S(lerr), "bad code")){
            err("原因: 包由旧版本 aardio 编译，与当前内核不匹配，请重新 build。");
        }
        pauseIfNeed();
        return 1;
    }

    var pkgArgs = scriptArgs();
    APP_ARGS = pkgArgs;

    info("正在执行 main.aardio ...");
    emit("------------------------------------------");
    var pret = null;
    var execErr = null;
    try{
        pret = func(table.unpack(pkgArgs));
    }
    catch(e){
        execErr = S(e);
    }
    emit("------------------------------------------");
    if(execErr){
        return exitErr("运行时错误: " ++ execErr);
    }

    if(pret != null){
        info("脚本返回: " ++ S(pret));
    }

    pauseIfNeed();
    return toExitCode(pret);
};

// ============================================================
//  子命令: info —— 打印包元信息（排错用）
// ============================================================

var cmdInfo = function(){
    var pkgPath = positional[1];
    if(!pkgPath){
        err("用法: aac info <包文件.appkg|独立EXE> [--no-pause]");
        pauseIfNeed();
        return 1;
    }

    var pkg, real, perr = preparePkg(pkgPath);
    if(!pkg){
        return exitErr(perr);
    }

    emit("文件    : " ++ S(real));
    emit("格式版本: " ++ S(pkg.meta["fmt"]));
    emit("应用名  : " ++ S(pkg.meta["app"]));
    emit("版本    : " ++ S(pkg.meta["ver"]));
    emit("构建时间: " ++ S(pkg.meta["time"]));
    emit("内核指纹: " ++ S(pkg.meta["kernel"]) ++ "（本机 " ++ aacpkg.kernelStamp() ++ "）");
    emit("CRC     : " ++ S(pkg.meta["crc"]) ++ "（校验通过）");
    emit("字节码  : " ++ #pkg.blobs ++ " 字节");
    emit("");
    emit("文件清单:");
    for(i = 1; #pkg.files; 1){
        emit("  " ++ pkg.files[i].rel ++ "  (" ++ pkg.files[i].len ++ " 字节)");
    }

    if(pkg.meta["kernel"] && pkg.meta["kernel"] != aacpkg.kernelStamp()){
        warn("内核指纹与本机不一致，该包可能无法在本机运行");
    }

    pauseIfNeed();
    return 0;
};

// ============================================================
//  子命令: libs —— 查看宿主预埋了哪些标准库
// ============================================================

var cmdLibs = function(){
    var hp = locateHost();
    if(!hp){
        warn("未找到 aardioHost.exe，无法查询预埋库清单");
        warn("把 aardioHost.exe 放到 aac 同目录，或用 --host=路径 指定");
        return 1;
    }
    var libs = extractHostLibs(string.load(hp));
    if(!libs){
        err("无法从宿主读出预埋库清单: " ++ hp);
        err("该宿主版本过旧，请执行 build.py 重新发布");
        return 1;
    }
    // 是否显示全部（默认按前缀分组精简）
    emit("宿主    : " ++ hp);
    emit("预埋库  : " ++ #libs ++ " 个");
    emit("");
    for(i = 1; #libs; 1){
        emit("  " ++ libs[i]);
    }
    emit("");
    emit("工程用到清单外的库时，不必手工改源码 —— 直接执行：");
    emit("    aac host-add <库名>[,<库名>...]");
    emit("会自动写入 aardioHost.aardio 并重建宿主。");
    return 0;
};

// ============================================================
//  子命令: host-add —— 自动给宿主补库
// ============================================================
// 以前缺库要三步手工操作: 改 aardioHost.aardio 的 import 列表 ->
// 同步 HOST_LIBS_DECL -> 跑 build.py 重新发布。每一步都容易出错,
// 而且「改漏 HOST_LIBS_DECL」这种失误编译期毫无症状, 运行时才崩。
// 这里把它们合成一条命令。
//
// 关于「库是不是要下载」:
//   aardio 的标准库随安装一次性装全（本机 lib 目录有 900+ 个模块文件）,
//   缺库并不需要联网下载 —— 缺的只是「被嵌进宿主 EXE」这一步。
//   只有第三方库才需要用 IDE 的「库管理器」安装, 本命令会明确区分。

// ---- 重建宿主 + 验证（host-add / host-del 共用）----
// 【踩过的坑】早期版本用 io.popen 跑 build.py，拿不到输出就直接 return 0。
// 结果是宿主根本没重建，命令却报成功；用户再跑一次 aac build 还是同样的
// 缺库，而且完全不知道该怀疑谁 —— 这正是「谎报成功」最伤人的形态。
//
// 所以退出码不取自子进程的返回值，而取自**事实**：重建之后再去读宿主 EXE
// 里的 __HOST_LIBS__ 哨兵，看这些库到底在不在里面。
var rebuildHost = function(rootDir, outHost, want){
    var Q = string.char(34);
    var buildPy = normPath(rootDir ++ "/build.py");
    if(!fileExists(buildPy)){
        err("找不到 build.py: " ++ buildPy);
        emit("  请手动执行: python build.py aardioHost-runner --out <宿主EXE路径>");
        return 1;
    }
    if(!outHost){ outHost = locateHost(); }
    if(!outHost){ outHost = normPath(io.joinpath(rootDir, "aardioHost.exe")); }

    var rbLog = normPath(rootDir ++ "/_rebuild_host.log");
    if(fileExists(rbLog)){ fsys.delete(rbLog); }

    emit("");
    emit("正在重建宿主（会短暂弹出 aardio IDE 窗口，脚本结束前会自动关闭）...");
    // 注意: 三个标准句柄必须全部重定向掉。
    // 只写 `> log 2>&1` 是不够的 —— python 启动时若 stdin 还是个管道/控制台句柄,
    // 会直接崩在 init_sys_streams:
    //     Fatal Python error: init_sys_streams: can't initialize sys standard streams
    //     ValueError: Cannot open console output buffer for reading
    // 表现为「宿主没重建但命令不报错」，排查成本极高。补一个 `< nul` 即可。
    // 不用 `cd /d X && python build.py`: 在 io.popen 起的 cmd 里 cd 有时不生效
    // （实测 python 报错 "can't open file '%AARDIO_HOME%\build.py'"，
    //  即根本没切过去）。直接给 build.py 绝对路径最稳，build.py 内部
    // 全部按 __file__ 定位，不依赖当前目录。
    // 命令**不能以引号开头**: cmd /c 见到开头是引号会走它自己的去引号规则,
    // 把整条命令切得面目全非（实测报 `'python" "D:' 不是内部或外部命令）。
    // 所以 python 这个词裸着写, 只有路径加引号。
    var cmdLine = "python"
                ++ " " ++ Q ++ buildPy ++ Q
                ++ " aardioHost-runner --out " ++ Q ++ outHost ++ Q
                ++ " > " ++ Q ++ rbLog ++ Q ++ " 2>&1 < nul";
    var pr = io.popen("cmd /c " ++ cmdLine, "r");
    if(pr){ pr.read(-1); pr.close(); }

    var po = string.load(rbLog) or "";
    if(#po){
        emit("---- build.py 输出（末尾 14 行）----");
        var lines = string.split(po, CH_LF);
        var st = 1;
        if(#lines > 14){ st = #lines - 13; }
        for(i = st; #lines; 1){ emit("  " ++ lines[i]); }
        emit("------------------------------------");
    }
    else {
        warn("build.py 没有任何输出（多半是命令行里找不到 python）");
    }

    // 事实校验: 读哨兵
    var hp2 = locateHost();
    var after = {};
    if(hp2){ after = extractHostLibs(string.load(hp2)) or {}; }
    var still = {};
    for(i = 1; #want; 1){
        if(!isOneOf(after, want[i])){ table.push(still, want[i]); }
    }
    if(#still){
        err("重建后宿主里仍然没有: " ++ joinText(still, ", "));
        err("  上面那条重建命令没有真正成功（常见原因: 命令行找不到 python、IDE 发布被中断）");
        emit("  请手动执行后重试:");
        emit("    python build.py aardioHost-runner --out " ++ outHost);
        return 1;
    }
    if(#want){
        ok("宿主已重建，新库已在预埋清单里（共 " ++ #after ++ " 个）");
    }
    else {
        ok("宿主已重建（预埋库 " ++ #after ++ " 个）");
    }
    return 0;
};

// ============================================================
//  宿主源码 import 区块: 解析 + 去重
// ============================================================
// 为什么 host-add 不能只信「宿主 EXE 里的哨兵」:
//   预埋是在 IDE 发布那一刻才写进 EXE 的。只要上一次 rebuild 没真成功
//   （python 找不到 / IDE 发布被中断 / 宿主被回滚），哨兵里就没有刚加过的库，
//   于是同一个库会被反复追加进源码 —— 实测 string.cmdline 被加了 5 次。
//   「下一次发布会预埋什么」的唯一真相是源码本身，哨兵只能当参考。
//
// 为什么去重要按「整行 + 前一个换行」精修而不是全文重写:
//   全文 split/join 会顺手改掉换行符和文件末尾换行（host-del 早期版本就踩过），
//   而生态环境里 diff 出来的噪音会让"这次到底改了什么"变得看不清。
// 库名字符集必须与 build.py 的 import 提取正则严格对齐: [A-Za-z_][\w.]*
var isLibName = function(s){
    if(!s or #s == 0){ return false; }
    var c0 = aacpkg.mid(s, 1, 1);
    var letter = (c0 >= "a" and c0 <= "z") or (c0 >= "A" and c0 <= "Z") or (c0 == "_");
    if(not letter){ return false; }
    for(k = 2; #s; 1){
        var c = aacpkg.mid(s, k, 1);
        var good = (c >= "a" and c <= "z")
                or (c >= "A" and c <= "Z")
                or (c >= "0" and c <= "9")
                or (c == "_") or (c == ".");
        if(not good){ return false; }
    }
    return true;
};

var hostScanImports = function(src){
    // 每条 = { 库名; 删除起点; 删除终点 }（起点含换行、终点含换行，整段切掉不留空行）
    var hits = {};
    var pos = 1;
    var prevNl = 0;
    while(pos <= #src){
        var nl = string.indexOf(src, CH_LF, pos);
        var lnl = nl ? nl : 0;                       // 0 = 本行没有换行符（文件末尾）
        var lineEnd = lnl ? (lnl - 1) : #src;
        var next = lnl ? (lnl + 1) : (#src + 1);
        if(lineEnd >= pos){
            var line = string.trim(aacpkg.mid(src, pos, lineEnd - pos + 1), WS);
            // 只认顶层 import; CRLF 的行尾 '\r' 已被 trim 吃掉
            if(string.startWith(line, "import ")){
                // 【必须与 build.py 同语义】名字取到第一个 ';' 为止, 分号后面
                // 还有东西也算数 —— `import x; // 说明` 是极常见的写法。
                // 早期版本要求整行以 ';' 结尾才算 import, 于是出现分歧:
                //   build.py  : 认这是 x 的 import, 纳入清单, 发布通过
                //   aac 侧     : 看不见它 → host-add x 再追加一条
                //   → 于是源码里两条 → check_host_libs 报「重复 import」
                //   → 而它给出的修复命令恰恰就是制造重复的那条命令, 死循环。
                var sc = string.indexOf(line, ";", 8);
                if(sc){
                    var nm = stripSpace(aacpkg.mid(line, 8, sc - 8));
                    if(isLibName(nm)){
                        table.push(hits, {nm; (prevNl + 1); (lnl ? lnl : #src)});
                    }
                }
            }
        }
        prevNl = lnl;
        pos = next;
    }
    return hits;
};

var hostSourceImports = function(src){
    var names = {};
    var hits = hostScanImports(src);
    for(i = 1; #hits; 1){
        if(!isOneOf(names, hits[i][1])){ table.push(names, hits[i][1]); }
    }
    return names;
};

// 同一条 import 出现多次时，保留第一次，其余整段切掉
var hostDedupeImports = function(src){
    var seen = {};
    var cutA = {};
    var cutB = {};
    var dups = {};
    var hits = hostScanImports(src);
    for(i = 1; #hits; 1){
        var nm = hits[i][1];
        if(isOneOf(seen, nm)){
            table.push(dups, nm);
            table.push(cutA, hits[i][2]);
            table.push(cutB, hits[i][3]);
        }
        else {
            table.push(seen, nm);
        }
    }
    // 从后往前删，前面的下标才不会失效
    for(i = #cutA; 1; -1){
        var a = cutA[i];
        var b = cutB[i];
        src = aacpkg.mid(src, 1, a - 1) ++ string.right(src, #src - b);
    }
    return src, dups;
};

// 哨兵清单必须与 import 区块严格同集合。与其往旧串后面手工追加
// （漏一条就漂移，多追一次就重复），不如每次按去重后的 import 列表整体重写。
var hostSyncSentinel = function(src){
    var s1 = string.indexOf(src, "__HOST_LIBS__*/");
    if(!s1){ return null, "宿主源码里没有 __HOST_LIBS__ 哨兵"; }
    var s2 = string.indexOf(src, "/*__HOST_LIBS_END__");
    if(!s2 || s2 < s1){ return null, "宿主源码里没有 __HOST_LIBS_END__ 哨兵"; }
    var begin = s1 + 15;
    var names = hostSourceImports(src);
    return aacpkg.mid(src, 1, begin - 1)
           ++ joinText(names, ",")
           ++ string.right(src, #src - (s2 - 1)), null;
};

var cmdHostAdd = function(){
    // --cwd 已在启动时处理, 这里不需要再管相对路径
    var todo = {};
    for(i = 1; #positional; 1){
        var one = string.split(positional[i], ",;");
        for(j = 1; #one; 1){
            var nm = stripSpace(one[j]);
            if(#nm){ table.push(todo, nm); }
        }
    }
    if(#todo == 0){
        err("请给出要补的库名，例如: aac host-add string.uuid,zlib.zip");
        emit("不知道确切名字？先用 aac libs 看看已有哪些，或让缺库报告直接给你命令。");
        pauseIfNeed();
        return 1;
    }

    var hostSrc = findFileUpwards("aardioHost.aardio");
    if(!hostSrc){
        return exitErr("找不到 aardioHost.aardio 源码，无法自动补库。" ++ "（请在 AardioCompile 工程目录或其任意子目录执行）");
    }
    hostSrc = normPath(io.fullpath(hostSrc));
    var src = string.load(hostSrc);
    if(!src){
        return exitErr("无法读取: " ++ hostSrc);
    }

    // 宿主 EXE 里的哨兵清单 —— 只做【诊断】，绝不参与下面的判定。
    //
    // 【为什么不能拿它判"已预埋"】它是上一次【成功发布】的产物快照,
    // 而 host-del 只改源码、EXE 要等 --rebuild 才更新, 中间那段窗口里
    // 哨兵必然比源码"多"。若用它跳过:
    //     host-del gamma → host-add gamma → 「已预埋，跳过」，什么都没做
    //   → 下一次发布真的没有 gamma → 用户补库 → 还是「已预埋」→ 死循环。
    // 因此"下次发布会预埋什么"只认源码 import 区块（见下）。
    var declared = {};
    var hp1 = locateHost();
    if(hp1){
        declared = extractHostLibs(string.load(hp1)) or {};
    }

    // 历史遗留的重复项顺手清掉: 同一条 import 出现多次没有语义差别，
    // 但会让 aac libs 报重复、让哨兵失去"清单"的意义。
    // 实测 string.cmdline 因为早期 rebuild 静默失败被追加了 5 次。
    var dupNames = {};
    src, dupNames = hostDedupeImports(src);
    if(#dupNames){
        warn("源码里有重复的 import，已自动清理: " ++ joinText(dupNames, ", "));
    }

    // 源码里已有的 import —— 这才是"下次发布会预埋什么"的**唯一**真相。
    // 哨兵只反映"上一次发布成功写进去了什么"，两者不一致时（发布失败/回滚/
    // 刚 host-del 完还没重建）必须以源码为准 —— 详见上面 declared 的注释。
    var inSource = hostSourceImports(src);

    // 哨兵比源码「多」出来的库: 说明这两个口令不同步（典型是刚 host-del 完
    // 还没 --rebuild）。明确报出来，别让用户对着「到底算预埋了没有」猜。
    var staleSentinel = {};

    var avail = scanAvailableLibs();
    var added   = {};
    var skipped = {};
    var unknown = {};
    var risky   = {};
    for(i = 1; #todo; 1){
        var lib = todo[i];
        // 注意: 这里【不能】再拿 declared（EXE 哨兵）判"已预埋" —— 见上面的注释
        if(isOneOf(added, lib) or isOneOf(inSource, lib)){
            table.push(skipped, lib);
        }
        elseif(isOneOf(avail, lib)){
            if(isOneOf(declared, lib)){ table.push(staleSentinel, lib); }
            if(isOneOf(HOST_FATAL_LIBS, lib) && !hasOpt("--force")){
                table.push(risky, lib ++ "（实测会让产物起不来，见 HOST_FATAL_LIBS）");
            }
            else {
                // 重副作用库会拖垮每一个由宿主打出的 EXE, 默认拒绝, 见 RISKY_IMPORTS
                var badDep = libRiskyImports(lib);
                if(badDep && !hasOpt("--force")){
                    table.push(risky, lib ++ "（会 import " ++ badDep ++ "）");
                }
                else {
                    // 改写 loadcode / string 等全局名的库同样致命, 见 HOST_CRITICAL_GLOBALS
                    var ov = libOverridesGlobals(lib);
                    if(ov && !hasOpt("--force")){
                        table.push(risky, lib ++ "（顶层改写了 " ++ joinText(ov, "/") ++ "）");
                    }
                    else {
                        table.push(added, lib);
                    }
                }
            }
        }
        else {
            table.push(unknown, lib);
        }
    }

    if(#risky){
        warn("以下库会在 import 时拉起重依赖，预埋后每个用宿主打出的 EXE 都可能卡死在启动阶段，已跳过:");
        for(i = 1; #risky; 1){
            emit("    " ++ risky[i]);
        }
        emit("  确实需要请加 --force，并务必重建后立刻冒烟验证一个最小 EXE。");
    }

    if(#unknown){
        for(i = 1; #unknown; 1){
            err("aardio 标准库里没有这个库: " ++ unknown[i]);
            var sug = suggestFrom(avail, unknown[i]);
            if(#sug){
                emit("  你是不是想输入: " ++ joinText(sug, ", "));
            }
            else {
                emit("  这不是 aardio 自带库。若是第三方库，请先用 aardio IDE 的「库管理器」安装，");
                emit("  安装成功后再执行本命令（安装后它就会出现在标准库目录里）。");
            }
        }
    }
    // 这条提示是整个 bug 的可见出口：以前它表现为「已预埋，跳过」+ 什么都不做，
    // 用户只知道补不上，不知道为什么。
    if(#staleSentinel){
        warn("这些库在【宿主 EXE 的哨兵清单】里有、但源码里没有 " ++ joinText(staleSentinel, ", "));
        emit("  说明两者没同步（典型情况：刚执行过 host-del 还没 --rebuild）。");
        emit("  判定一律以源码为准，本次会当作新库补上；重新发布后两者即恢复一致。");
    }

    if(#skipped){
        info("宿主源码已预埋，跳过: " ++ joinText(skipped, ", "));
    }
    if(#added == 0){
        // 没有新库，但可能刚清理了重复项 —— 那也必须落盘，否则等于白清
        if(#dupNames){
            var nsD, sErrD = hostSyncSentinel(src);
            if(!nsD){ return exitErr(sErrD); }
            if(!string.save(hostSrc, nsD)){
                return exitErr("宿主源码写入失败: " ++ hostSrc);
            }
            ok("已整理宿主源码: " ++ hostSrc);
            if(hasOpt("--rebuild")){
                var rdir5 = normPath(io.splitpath(hostSrc).dir);
                var rc5 = rebuildHost(rdir5, hp1, {});
                pauseIfNeed();
                return rc5;
            }
            emit("");
            emit("预埋清单还要重新发布一次宿主才会生效:");
            emit("    python build.py aardioHost-runner --out <宿主EXE路径>");
            pauseIfNeed();
            return 0;
        }
        // 显式给了 --rebuild 就照样重建: 用户要的是"重新发布一次宿主",
        // 哪怕没有新库（例如刚手工改过 aardioHost.aardio）。
        // 以前这里直接 rc=1 早退, 让 --rebuild 在这种场景下形同虚设。
        if(hasOpt("--rebuild")){
            var rdir = normPath(io.splitpath(hostSrc).dir);
            var rc4 = rebuildHost(rdir, hp1, {});
            pauseIfNeed();
            return rc4;
        }
        // 全部都已预埋、且没有任何一个被拒绝/找不到: 这是幂等的空操作,
        // 不该算失败。CI 里执行两遍就 rc=1 会打断流水线，
        // 而"已预埋"恰恰是这个命令要达到的状态。
        if(#skipped and #risky == 0 and #unknown == 0){
            ok("全部已预埋，无事可做: " ++ joinText(skipped, ", "));
            pauseIfNeed();
            return 0;
        }
        return exitErr("没有需要新增的库");
    }

    // ---- 写入源码: 插到最后一个 import 语句之后 ----
    var insPos = 0;
    var pos = 0;
    while(true){
        var p = string.indexOf(src, CH_LF ++ "import ", (pos + 1) or 1);
        if(!p){ break; }
        insPos = p;
        pos = p;
    }
    if(insPos == 0){
        // 源码可能被格式化成行首就是 import（文件开头）
        if(string.startWith(src, "import ")){ insPos = 1; }
    }
    if(insPos == 0){
        return exitErr("在 aardioHost.aardio 里没找到 import 区块，无法自动插入");
    }

    var eol = string.indexOf(src, ";", insPos);
    if(!eol){
        return exitErr("最后一个 import 语句没有分号结尾，无法自动插入");
    }
    var head = string.left(src, eol);
    var tail = string.right(src, #src - eol);
    var blocktxt = "";
    for(i = 1; #added; 1){
        blocktxt = blocktxt ++ CRLF ++ "import " ++ added[i] ++ ";";
    }
    var newSrc = head ++ blocktxt ++ tail;

    // ---- 同步 HOST_LIBS_DECL 哨兵 ----
    // 整体按去重后的 import 列表重写，而不是往旧串尾部追加:
    // 追加会在每次 rebuild 失败后再补一次重复的库名。
    var newSrc2, sErr = hostSyncSentinel(newSrc);
    if(!newSrc2){ return exitErr(sErr); }
    newSrc = newSrc2;

    if(!string.save(hostSrc, newSrc)){
        return exitErr("宿主源码写入失败: " ++ hostSrc);
    }
    ok("已更新宿主源码: " ++ hostSrc);
    info("新增库: " ++ joinText(added, ", "));

    // ---- 自动重建宿主 ----
    // 预埋是在「IDE 发布」这一刻完成的, 运行时不可能凭空追加,
    // 所以必须再由 IDE 过一遍。--rebuild 就是把这一步也包了。
    if(hasOpt("--rebuild")){
        var rootDir = normPath(io.splitpath(hostSrc).dir);
        var rc2 = rebuildHost(rootDir, hp1, added);
        pauseIfNeed();
        return rc2;
    }

    emit("");
    emit("下一步（预埋必须经 IDE 发布一次，无法在运行时追加）:");
    emit("    python build.py aardioHost-runner --out <宿主EXE路径>");
    emit("或者直接用一条命令做完: aac host-add " ++ joinText(todo, ",") ++ " --rebuild");
    emit("");
    emit("说明: 标准库已随 aardio 安装在本机，不需要下载；");
    emit("      只是要重新生成一个把它们嵌进去的宿主。");
    pauseIfNeed();
    return 0;
};

// ============================================================
//  aac host-del —— 从宿主里剔除库
// ============================================================
// 为什么必须有它:
// 预埋是「一次写进 EXE」的, 加错了不能靠下次覆盖修正, 只能删掉重建。
// 手工编辑 aardioHost.aardio 很容易只删 import 忘删哨兵清单(或反之),
// 两边漂移后就是"看起来预埋了其实没有"。所以让命令同时改这两处。
var cmdHostDel = function(){
    var todo = {};
    for(i = 1; #positional; 1){
        var one = string.split(positional[i], ",;");
        for(j = 1; #one; 1){
            var nm = stripSpace(one[j]);
            if(#nm){ table.push(todo, nm); }
        }
    }
    if(#todo == 0){
        err("请给出要剔除的库名，例如: aac host-del java.jre.v8,inet.file");
        pauseIfNeed();
        return 1;
    }

    var hostSrc = findFileUpwards("aardioHost.aardio");
    if(!hostSrc){
        return exitErr("找不到 aardioHost.aardio 源码（请在 AardioCompile 工程目录或其子目录执行）");
    }
    hostSrc = normPath(io.fullpath(hostSrc));
    var src = string.load(hostSrc);
    if(!src){ return exitErr("无法读取: " ++ hostSrc); }

    var s1 = string.indexOf(src, "__HOST_LIBS__*/");
    var s2 = string.indexOf(src, "/*__HOST_LIBS_END__");
    if(!s1 || !s2 || s2 < s1){
        return exitErr("宿主源码里没有完整的 __HOST_LIBS__ 哨兵，无法安全修改");
    }
    var begin = s1 + 15;
    var oldList = aacpkg.mid(src, begin, s2 - begin);

    var declared = string.split(oldList, ",");
    var removed = {};
    var absent  = {};
    var newSrc = src;
    var endsNl = (string.right(src, 1) == CH_LF);
    for(i = 1; #todo; 1){
        var lib = todo[i];
        if(!isOneOf(declared, lib)){
            table.push(absent, lib);
        }
        else {
            // 逐行比对, 只删整行的 `import lib;`, 避免误伤 import lib.sub
            var out = {};
            var pos = 1;
            while(true){
                var nl = string.indexOf(newSrc, CH_LF, pos);
                var line = null;
                if(nl){
                    line = aacpkg.mid(newSrc, pos, nl - pos);
                    pos = nl + 1;
                }
                else {
                    line = string.right(newSrc, #newSrc - (pos - 1));
                    pos = #newSrc + 1;
                }
                var tl = string.trim(line, WS);
                // 与 hostScanImports / build.py 同语义: 名字取到第一个 ';'
                // 为止。写成 tl == "import x;" 的话, `import x; // 说明`
                // 这种行永远匹配不上, 表现为"删了却还在"。
                var dlib = null;
                if(string.startWith(tl, "import ")){
                    var sc = string.indexOf(tl, ";", 8);
                    if(sc){ dlib = stripSpace(aacpkg.mid(tl, 8, sc - 8)); }
                }
                if(dlib and dlib == lib){
                    table.push(removed, lib);
                }
                else {
                    table.push(out, line);
                }
                if(pos > #newSrc){ break; }
            }
                // 按行重建会把文件末尾那个换行弄丢（每行保留了各自的 '\r'，
                // CRLF 不会退化成 LF），这里补回去，避免每次 host-del 都多一行 diff 噪音
                newSrc = joinText(out, CH_LF) ++ (endsNl ? CH_LF : "");
            }
    }

    if(#absent and #removed){
        info("有一部分本来就没有，跳过: " ++ joinText(absent, ", "));
    }
    if(#removed == 0){
        // 删一个本来就不存在的库是幂等空操作，不该算失败（同 host-add）
        if(#absent){
            ok("宿主本来就没有，无事可做: " ++ joinText(absent, ", "));
            pauseIfNeed();
            return 0;
        }
        return exitErr("没有需要剔除的库");
    }

    // 同步哨兵清单: 按剩下的 import 整体重写（顺带把历史重复项一起清掉）
    var newSrc3, sErr3 = hostSyncSentinel(newSrc);
    if(!newSrc3){ return exitErr(sErr3); }
    newSrc = newSrc3;

    if(!string.save(hostSrc, newSrc)){
        return exitErr("宿主源码写入失败: " ++ hostSrc);
    }
    ok("已从宿主源码剔除: " ++ joinText(removed, ", "));
    info("剩余预埋库: " ++ #hostSourceImports(newSrc) ++ " 个");

    if(hasOpt("--rebuild")){
        var rootDir = normPath(io.splitpath(hostSrc).dir);
        var rc3 = rebuildHost(rootDir, null, {});
        pauseIfNeed();
        return rc3;
    }
    emit("");
    emit("下一步: python build.py aardioHost-runner --out <宿主EXE路径>");
    pauseIfNeed();
    return 0;
};



// ============================================================
//  主入口
// ============================================================

var dispatch = function(){
    // 未知参数先于一切业务处理拦掉
    if(!checkArgs()){ return 1; }

    if(!cmd || cmd == ""){
        showHelp();
        pauseIfNeed();
        return 1;
    }

    if(cmd == "build"){        return cmdBuild(); }
    elseif(cmd == "compile"){  return cmdCompile(); }
    elseif(cmd == "run"){      return cmdRun(); }
    elseif(cmd == "exec"){     return cmdExec(); }
    elseif(cmd == "info"){     return cmdInfo(); }
    elseif(cmd == "libs"){     return cmdLibs(); }
    elseif(cmd == "host-add"){ return cmdHostAdd(); }
    elseif(cmd == "host-del"){ return cmdHostDel(); }
    elseif(cmd == "version" || cmd == "--version" || cmd == "-V"){
        showVersion();
        pauseIfNeed();
        return 0;
    }
    elseif(cmd == "help" || cmd == "--help" || cmd == "-h"){
        showHelp();
        pauseIfNeed();
        return 0;
    }

    err("未知子命令: " ++ cmd);
    emit("");
    showHelp();
    pauseIfNeed();
    return 1;
};

// 统一兜底: 任何未捕获异常都要能落到 --log 里, 否则调用方只能看到退出码 -1。
// 【坑】return 写在 try/catch 里不生效，必须先把结果落到变量再在块外处理。
var rc = 0;
try{
    rc = dispatch();
    if(!rc){ rc = 0; }
}
catch(e){
    err("未捕获异常: " ++ S(e));
    pauseIfNeed();
    rc = 1;
}
hardExit(rc);
return rc;
