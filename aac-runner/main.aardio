    emit("aac " ++ AAC_VERSION ++ " —— aardio 命令行编译器（dumpcode 模式，不依赖 IDE）");
    emit("");
    emit("用法:");
    emit("  aac build   <工程目录|.aproj> [选项]");
    emit("  aac compile <源文件.aardio> <输出.dump> [选项]");
    emit("  aac run     <脚本.aardio|.dump> [脚本参数...] [选项]");
    emit("  aac exec    <包文件.appkg> [脚本参数...] [选项]");
    emit("  aac info    <包文件.appkg|独立EXE> [选项]");
    emit("  aac libs                               [选项]");
    emit("  aac host-add <库名>[,<库名>...] [--rebuild]");
    emit("  aac host-del <库名>[,<库名>...] [--rebuild]");
    emit("  aac version");
    emit("  aac help");
    emit("");
    emit("子命令:");
    emit("  build     编译完整工程 -> .appkg + 独立 EXE（需 aardioHost.exe）");
    emit("  compile   编译单文件 .aardio -> .dump 字节码");
    emit("  run       编译并执行 .aardio 源码或 .dump 字节码");
    emit("  exec      加载 .appkg 并执行包内 main.aardio");
    emit("  info      打印包内元信息与文件清单（排错用）");
    emit("  libs      列出 aardioHost.exe 预埋的标准库");
    emit("  host-add  给宿主补标准库（自动改源码 + 哨兵清单，--rebuild 直接重建）");
    emit("  host-del  从宿主剔除库（加错了只能删掉重建，命令同时改 import 与哨兵）");
    emit("");
    emit("build 选项:");
    emit("  --out=路径        输出目录，或具体文件（*.exe / *.appkg）");
    emit("  --name=应用名     覆盖应用名（默认取 .aproj 的 output）");
    emit("  --ver=版本号      覆盖版本号（默认取 .aproj 的 FileVersion）");
    emit("  --host=路径       指定 aardioHost.exe（默认在 aac 同目录/上级目录找）");
    emit("  --no-exe          只生成 .appkg，不生成独立 EXE");
    emit("  --no-lib-check    跳过宿主预埋库依赖检查");
    emit("  --auto-host       缺库时自动 host-add 并重建宿主，一条命令闭环");
    emit("  --force           允许预埋有重副作用的库（如会拉起 UIA 的 winex.caret）");
    emit("  --exclude=a,b     追加排除的目录名（默认已排除 dist/.build/.git 等）");
    emit("");
    emit("公共选项:");
    emit("  --cwd=目录        指定相对路径的基准目录（见下方【当前目录】）");
    emit("  --no-pause        禁止结束暂停（CI 必须加）");
    emit("  --log=文件        把全部输出镜像落盘（自动隐含 --no-pause）");
    emit("  --quiet / -q      只输出 [OK]/[ERR]/[WARN]");
    emit("  --                之后的参数原样透传给脚本，不再按 aac 选项解释");
    emit("");
    emit("【当前目录】aardio 发布的独立 EXE 会在任何用户代码执行前把当前目录");
    emit("   强制切到 EXE 所在目录，进程内无法取回调用方的当前目录。");
    emit("   因此相对路径不会按你在终端里的当前目录解析。请三选一:");
    emit("     1) 写绝对路径          aac build D:/path/to/proj");
    emit("     2) 显式给基准目录      aac build proj --cwd=D:/path/to");
    emit("     3) 改用随包的 aac.cmd  它会自动把当前目录注入成 --cwd");
    emit("");
    emit("【库从哪来】aardio 的标准库随安装一次性装全，缺库不需要联网下载，");
    emit("   缺的是「被嵌进宿主 EXE」这一步 —— 用 aac host-add 补即可。");
    emit("   只有第三方库才需要先在 aardio IDE 的「库管理器」里安装。");
    emit("");
    emit("退出码:");
    emit("  0   成功");
    emit("  1   失败");
    emit("  n   run/exec/独立EXE：被调脚本 main 返回的数字（0~255）");
    emit("");
