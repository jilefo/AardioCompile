// ============================================================
//  宿主能力清单
// ============================================================
// 这不是可执行代码: 发布后这段常量字符串会留在 EXE 字节里,
// aac build 用 __HOST_LIBS__ / __HOST_LIBS_END__ 两个哨兵把它读出来,
// 用来校验工程 import 的库是否都已被预埋。
//
// ⚠ 必须与上面的 import 列表严格一致。build.py 发布前会自动核对,
//   两边不一致会拒绝发布, 避免出现"看起来预埋了其实没有"。
HOST_LIBS_DECL = "/*__HOST_LIBS__*/JSON,System,access,access.oleDb,base64,bencode,builtin,color,console,coroutine,crypt,crypt.bin,crypt.aes,crypt.rsa,crypt.hmac,crypt.random,debug,dotNet,fsys,fsys.file,fsys.path,fsys.dirWatcher,fsys.log,fsys.ini,fsys.table,fsys.stream,fsys.watch,fsys.version,fsys.shortcut,fsys.environment,fsys.info,fsys.remove,fsys.time,fsys.url,fsys.res,fsys.mmap,fsys.codepage,gdi,icmp.ping,inet,inet.http,inet.whttp,inet.url,inet.tls,inet.downBox,inet.curlParse,inet.util,inet.adapter,inet.mac,inet.stat,key,key.hotkey,key.ime,math,math.format,mouse,mouse.hook,process,process.popen,process.batch,process.mutex,process.admin,process.list,process.temp,process.command,raw,raw.memory,raw.struct,raw.functions,sqlite,string,string.regex,string.builder,string.csv,string.xml,string.html,string.ini,string.list,string.uuid,string.conv,string.template,string.stream,string.glob,string.padding,string.encoding,string.textTable,string.oct,sys,sys.cpu,sys.mem,sys.info,sys.display,sys.reg,sys.run,sys.locale,sys.volume,sys.monitor,sys.printer,sys.networkCards,sys.power,sys.storage,textkit,thread,thread.command,thread.event,thread.manage,thread.works,thread.table,thread.semaphore,time,time.performance,time.timer,time.zone,time.lunar,time.util,time.js,time.period,ustring,util,web,web.form,web.json,web.rest.client,web.rest.jsonLiteClient,web.form.util,win,win.api,win.form,win.ui,win.reg,win.clip,win.guid,win.timer,win.dlg,win.inputBox,win.image,win.cur,win.version,win.taskScheduler,win.messageFilter,win.debounce,winex,winex.ctrl,winex.key,winex.mouse,winex.tooltip,winex.desktop,wsock,zlib,zlib.zip,zlib.unzip,com,com.excel,com.wmi,com.shell,com.activeX,sevenZip.lzma,sqlServer,table,string.res,fsys.config,fsys.dlg,win.ui.atom,win.ui.menu,fonts.fontAwesome,web.view,wsock.tcp.simpleHttpServer,win.util.tray,win.ui.simpleWindow,fsys.dlg.dir,win.ui.tooltip,win.dlg.message,web.rest.jsonClient,win.ui.tabs,win.ui.shadow,inet.httpFile,win.ui.grid,win.ui.minmax,util.metaProperty,win.ui.statusbar,fastcgi,fastcgi.client,wsock.tcp.client,java,service,win.ui.accelerator,web.socket.server,gdip.bitmap,win.ui.simpleWindow2,win.imageList,gdip,process.job.limitKill,fsys.hosts,crypt.des,gdip.graphics,fsys.tar,web.mshtml,process.ffmpeg,service.simpleTool,sys.runAsTask,debug.log,fsys.lnk,string.conv.pinyin,win.clip.viewer,time.ole,win.ui.resizeBorder,win.ui.tracker,win.ui.toolbar,gdip.image,console.progress,thread.token,crypt.protectData,process.code,process.aardio,ide.aifix,util.testRunner,zlib.httpFile,process.file,web.rest.htmlClient,wsock.networkChange,inet.ras,chrome.path,chrome.app,thread.dlManager,wsock.tcp.asynHttpServer,win.ui.mask,process.wmi,win.versionEx,fsys.update.dlMgr,process.cache,process.rundll,sevenZip.lzma.httpFile,fsys.acl,com.interface.ITfInputProcessorProfileMgr,fonts,fsys.update.simpleMain,fsys.cab.maker,gdip.snap,sys.wallpaper,web.rpc.externalServer,fsys.untar,win.dlg.ctrlColor,win.ui.fade,gdip.feather,key.hook,web.socket.client,web.msxml,sys.vc14,thread.apiHook,web.socket.jsonServer,web.rpc.jsonServer,string.aasdl,inet.installer,inet.adapterInfo,web.form.simpleMarkdown,gdip.imageAttributes,gdip.family,gdip.path,gdip.solidBrush,gdip.pen,gdip.stringFormat,gdip.font,string.keywords,win.clip.file,web.script,win.ui.listEdit,inet.conn,table.product,inet.urlpart,win.clip.html,dotNet.ocr,com.interface.ITaskbarList3,process.git,process.rpc.jsonClient,win.ui.ctrl,win.ui.ctrl.metaProperty,win.ui.ctrl.plus,System.IO.Compression.ZipFile,string.cmdline/*__HOST_LIBS_END__*/";

// 解析成数组, 供 --pkg-info 展示
HOST_LIBS = string.split(
    aacpkg.mid(HOST_LIBS_DECL,
        string.indexOf(HOST_LIBS_DECL, "__HOST_LIBS__*/") + 15,
        string.indexOf(HOST_LIBS_DECL, "/*__HOST_LIBS_END__")
            - (string.indexOf(HOST_LIBS_DECL, "__HOST_LIBS__*/") + 15)),
    ",");

// ============================================================
//  基础工具（本文件不依赖外部模块, aacpkg 由 build.py 内联）
// ============================================================

var S = function(v){
    if(v == null){ return ""; }
    return tostring(v);
};

var emit = function(s){
    console.log(S(s));
};

var hardExit = function(code){
    try{
        var sys = dotNet.import("System");
        sys.Environment.Exit(code);
    }
    catch(e){
        // 退出码设置失败也要往下走, 由 return 兜底
    }
    return code;
};

var fail = function(msg){
    emit("[ERR] " ++ S(msg));
    hardExit(1);
    return 1;
};

// 与 aac 的 toExitCode 保持完全相同的约定
var toExitCode = function(ret){
    if(ret == null){ return 0; }
    var tc = type(ret);
    if(tc == "boolean"){ return ret ? 0 : 1; }
    if(tc != "number"){ return 0; }
    var n = ret;
    if(n < 0 || n > 255){
        emit("[WARN] main 返回值 " ++ tostring(ret) ++ " 超出 0~255，已收敛");
        n = n % 256;
    }
    return n;
};

// ============================================================
//  解析宿主专用参数
// ============================================================

// 【已实测】string.save 对纯字符串是字节直通, 第 4 个代码页参数不会转换编码
//   (传 936/GBK 写出来的仍是 UTF-8)。保留 65001 只为表明意图。
// 中文在终端里乱码是控制台代码页(936)的问题, 不是文件内容的问题 —— chcp 65001 即可。
// 【坑】双引号串里 "\t" "\r\n" 是字面字符不是转义(详见 aac.aardio 顶部说明)。
// 日志文件里若全是假的换行, 排错时就是一整坨挤在一起的长行。
var CH_TAB = string.char(9);
var CH_CR  = string.char(13);
var CH_LF  = string.char(10);
var CRLF   = CH_CR ++ CH_LF;
var CP_UTF8 = 65001;

var logPath  = null;
var pkgInfo  = false;
var traceOn  = false;
var appArgs  = {};

var i = 1;
var sawSep = false;
while(i <= #_ARGV){
    var a = S(_ARGV[i]);
    if(!sawSep && a == "--"){
        // 之后的参数一律原样交给被打包的程序, 不再解释为宿主参数
        sawSep = true;
    }
    elseif(sawSep){
        table.push(appArgs, a);
    }
    else {
        var v = string.match(a, `--log=(.*)`);
        if(v){
            logPath = v;
        }
        elseif(a == "--pkg-info"){
            pkgInfo = true;
        }
        elseif(a == "--trace"){
            // 启动期旁路诊断。默认关闭 —— 一旦默认打开, 每个用户的
            // --log 里都会被 [TRACE] 行淹掉, 真正的应用输出反而难找。
            traceOn = true;
        }
        else {
            table.push(appArgs, a);
        }
    }
    i = i + 1;
}

// 剔除宿主专用参数后, 交给被打包程序的是全局 APP_ARGS。
// 注意: _ARGV 是 aardio 内核常量, 不能重新赋值,
// 写 _ARGV = appArgs 会直接抛 "Can't modify the constant : '_ARGV'"。
APP_ARGS = appArgs;

if(logPath){
    logPath = string.replace(S(logPath), string.char(92) ++ string.char(92), "/");
    logPath = io.fullpath(logPath);
    var logDir = string.match(logPath, `^(.*)/[^/]+$`);
    if(logDir && !io.exist(logDir)){
        fsys.createDir(logDir);
    }
    string.save(logPath, "", false, CP_UTF8);
    var rawLog = console.log;
    console.log = function(...){
        var va = {...};
        var buf = "";
        for(k = 1; #va; 1){
            if(k > 1){ buf = buf ++ CH_TAB; }
            buf = buf ++ S(va[k]);
        }
        string.save(logPath, buf ++ CRLF, true, CP_UTF8);
        return rawLog(...);
    };
}

// ============================================================
//  读取自身并解包
// ============================================================

// 【排错用】启动期 trace: 直接写文件, 不走 console。
// 为什么需要: 曾经出过「产物静默失败」——退出码 -1、日志一个字都没有。
// 凡是走 console.log 的诊断在这类故障里全都不可信(日志镜像本身就依赖
// console.log 被正确替换), 必须有一条完全不依赖控制台的旁路。
tracePath = traceOn ? logPath : null;
trace = function(s){
    if(!tracePath){ return; }
    string.save(tracePath, "[TRACE] " ++ S(s) ++ CRLF, true, CP_UTF8);
};
trace("init: 进入解包阶段");

// 坑: aardio 没有 _EXEFILE 这个全局变量（恒为 null）, 取自身路径要用 io._exepath
var selfPath = io._exepath;
trace("init: selfPath=" ++ S(selfPath));

var bin = string.load(selfPath);
if(!bin){
    trace("init: string.load 失败");
    return fail("无法读取自身文件: " ++ S(selfPath));
}
trace("init: 读入 " ++ #bin ++ " 字节");

var pkg, perr = aacpkg.parse(bin);
trace("init: parse=" ++ (pkg ? "OK" : ("FAIL " ++ S(perr))));
if(!pkg){
    emit("本程序是由 aac build 生成的独立应用，请勿手动修改。");
    return fail("包解析失败: " ++ S(perr));
}

if(pkgInfo){
    emit("宿主      : " ++ S(selfPath));
    emit("格式版本  : " ++ S(pkg.meta["fmt"]));
    emit("应用名    : " ++ S(pkg.meta["app"]));
    emit("应用版本  : " ++ S(pkg.meta["ver"]));
    emit("构建时间  : " ++ S(pkg.meta["time"]));
    emit("内核指纹  : " ++ S(pkg.meta["kernel"]) ++ "（本机 " ++ aacpkg.kernelStamp() ++ "）");
    emit("预埋库    : " ++ #HOST_LIBS ++ " 个（--pkg-info-libs 查看）");
    emit("字节码    : " ++ #pkg.blobs ++ " 字节");
    emit("文件清单  :");
    for(i = 1; #pkg.files; 1){
        emit("  " ++ pkg.files[i].rel ++ "  (" ++ pkg.files[i].len ++ " 字节)");
    }
    hardExit(0);
    return 0;
}

// 内核指纹: 不一致时明确告警, 避免只看到莫名的 "bad code"
if(pkg.meta["kernel"] && pkg.meta["kernel"] != aacpkg.kernelStamp()){
    emit("[WARN] 该程序由不同版本 aardio 内核编译，可能无法正常运行，请用当前版本重新 build。");
}

// ============================================================
//  建立模块表并执行
// ============================================================

PKG = {};
for(i = 1; #pkg.files; 1){
    PKG[pkg.files[i].rel] = pkg.files[i].code;
}

loadModule = function(relPath){
    relPath = string.replace(S(relPath), string.char(92) ++ string.char(92), "/");
    var code = PKG[relPath];
    if(!code){
        return null, "模块不存在: " ++ relPath;
    }
    var f, e = loadcode(code);
    if(!f){
        return null, S(e);
    }
    return f;
};

var mainCode = PKG["main.aardio"];
if(!mainCode){
    trace("init: 包内缺少 main.aardio");
    return fail("包内缺少 main.aardio");
}
trace("init: mainCode " ++ #mainCode ++ " 字节, 准备 loadcode");

var func, lerr = loadcode(mainCode);
trace("init: loadcode=" ++ (func ? "OK" : ("FAIL " ++ S(lerr))));
if(!func){
    emit("[ERR] main.aardio 字节码加载失败: " ++ S(lerr));
    if(string.find(S(lerr), "bad code")){
        emit("[ERR] 原因: 宿主与编译器使用的 aardio 内核版本不一致，请用同一版本重新构建。");
    }
    hardExit(1);
    return 1;
}

// 【坑】return 写在 catch 里不生效(aardio 会继续往下执行并返回 null),
// 必须先落到标志变量, 判退出码的语句放在 try/catch 之外。
var rc = 0;
var runtimeErr = null;
trace("init: 即将执行载荷");
try{
    rc = func(table.unpack(appArgs));
    trace("init: 载荷返回 " ++ S(rc));
}
catch(ex){
    runtimeErr = S(ex);
    trace("init: 载荷抛异常 " ++ runtimeErr);
}
if(runtimeErr){
    emit("[ERR] 运行时错误: " ++ runtimeErr);
    hardExit(1);
    return 1;
}

// 被打包的程序可以 return 一个数字作为进程退出码
hardExit(toExitCode(rc));
return 0;
